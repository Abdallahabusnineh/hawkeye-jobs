<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened Runtime exceptions the bundled Python needs (required for notarization). -->
<plist version="1.0">
<dict>
    <!-- ctypes / cffi callbacks (curl_cffi, pyobjc) write executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Load the bundled Python extensions and libraries (signed with our ID, not Apple's). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
